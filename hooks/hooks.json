{
  "description": "Mantém o quadro em dia nos projetos que a pessoa ativou. Nos outros, não faz nada.",
  "hooks": {
    "SessionStart": [
      { "matcher": "startup|resume", "hooks": [ { "type": "command", "command": "python3", "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/hook.py", "session"], "timeout": 60 } ] }
    ],
    "PostToolUse": [
      { "matcher": "Bash", "hooks": [ { "type": "command", "command": "python3", "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/hook.py", "after-bash"], "timeout": 10 } ] }
    ]
  }
}
